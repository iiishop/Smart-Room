/* Discover Client -- Dracula Dark QSS v2 */

/* Global */
QWidget {
    color: rgb(221, 221, 221);
    font: 10pt "Segoe UI";
    background-color: rgb(40, 44, 52);
}

QMainWindow {
    background-color: rgb(40, 44, 52);
}

/* Toolbar */
#toolbar {
    background-color: rgb(33, 37, 43);
    border-bottom: 2px solid rgb(44, 49, 58);
    padding: 6px 8px;
}

/* Palette (left sidebar) */
#sourcePalette {
    background-color: rgb(33, 37, 43);
    border-right: 2px solid rgb(44, 49, 58);
}

#paletteTitle {
    color: rgb(189, 147, 249);
    font-size: 14pt;
    font-weight: bold;
    padding: 14px 12px 6px 12px;
    background: transparent;
}

#paletteCard {
    background-color: rgb(44, 49, 58);
    border: 1px solid rgb(44, 49, 58);
    border-radius: 8px;
    margin: 2px 10px;
}

#paletteCard:hover {
    background-color: rgb(55, 60, 70);
    border: 1px solid rgb(189, 147, 249);
}

#paletteName {
    color: rgb(221, 221, 221);
    font-size: 11pt;
    font-weight: bold;
    background: transparent;
}

#paletteDesc {
    color: rgb(120, 125, 145);
    font-size: 9pt;
    background: transparent;
}

/* Source panel cards (right side) */
#sourcePanel {
    background-color: rgb(33, 37, 43);
    border: 1px solid rgb(44, 49, 58);
    border-radius: 8px;
}

#sourcePanel::title {
    color: rgb(189, 147, 249);
    font-weight: bold;
}

#panelName {
    font-size: 12pt;
    font-weight: bold;
    background: transparent;
}

#panelType {
    color: rgb(189, 147, 249);
    font-size: 9pt;
    font-weight: bold;
    background: transparent;
    margin-left: 6px;
}

#panelStats {
    color: rgb(140, 145, 160);
    font-size: 9pt;
    background: transparent;
}

#panelPreview {
    color: rgb(120, 125, 145);
    font-size: 9pt;
    background: transparent;
}

#panelDot {
    font-size: 14pt;
    background: transparent;
}

#panelTable {
    background-color: rgb(40, 44, 52);
    border: 1px solid rgb(44, 49, 58);
    border-radius: 4px;
    gridline-color: rgb(44, 49, 58);
    font-size: 9pt;
}

#panelTable QHeaderView::section {
    background-color: rgb(33, 37, 43);
    color: rgb(189, 147, 249);
    border: none;
    border-bottom: 1px solid rgb(44, 49, 58);
    padding: 4px 8px;
    font-weight: bold;
}

/* Global event log table */
#globalLogTable {
    background-color: rgb(40, 44, 52);
    border: 1px solid rgb(44, 49, 58);
    border-radius: 4px;
    gridline-color: rgb(44, 49, 58);
    font-size: 9pt;
}

#globalLogTable QHeaderView::section {
    background-color: rgb(33, 37, 43);
    color: rgb(189, 147, 249);
    border: none;
    border-bottom: 1px solid rgb(44, 49, 58);
    padding: 4px 8px;
    font-weight: bold;
}

#evidenceTable {
    background-color: rgb(40, 44, 52);
    border: 1px solid rgb(44, 49, 58);
    border-radius: 4px;
    gridline-color: rgb(44, 49, 58);
    font-size: 9pt;
}

#evidenceTable QHeaderView::section {
    background-color: rgb(33, 37, 43);
    color: rgb(189, 147, 249);
    border: none;
    border-bottom: 1px solid rgb(44, 49, 58);
    padding: 4px 8px;
    font-weight: bold;
}

#navBtn {
    background-color: rgb(44, 49, 58);
    color: rgb(221, 221, 221);
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 10pt;
    font-weight: bold;
}

#navBtn:hover {
    background-color: rgb(55, 60, 70);
}

QTabWidget::pane {
    border: 1px solid rgb(44, 49, 58);
    background-color: rgb(40, 44, 52);
}

QTabBar::tab {
    background-color: rgb(33, 37, 43);
    color: rgb(189, 147, 249);
    padding: 6px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: rgb(44, 49, 58);
    color: rgb(221, 221, 221);
}

QTabBar::tab:hover {
    color: rgb(221, 221, 221);
}

/* Buttons */
QPushButton {
    background-color: rgb(189, 147, 249);
    color: rgb(33, 37, 43);
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 10pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: rgb(205, 170, 255);
}

QPushButton:pressed {
    background-color: rgb(160, 120, 220);
}

QPushButton:disabled {
    background-color: rgb(60, 65, 75);
    color: rgb(100, 105, 115);
}

#btnStart {
    background-color: rgb(80, 200, 120);
}

#btnStart:hover {
    background-color: rgb(100, 220, 140);
}

#btnStop {
    background-color: rgb(255, 90, 90);
}

#btnStop:hover {
    background-color: rgb(255, 120, 120);
}

#btnDelete {
    background-color: transparent;
    color: rgb(120, 125, 145);
    border: none;
    font-size: 12pt;
    font-weight: bold;
    padding: 0px;
    border-radius: 4px;
}

#btnDelete:hover {
    background-color: rgb(60, 50, 50);
    color: rgb(255, 90, 90);
}

/* Dialog */
#sourceDialog {
    background-color: rgb(33, 37, 43);
}

QDialog QLabel {
    background: transparent;
}

QDialog QLineEdit,
QDialog QSpinBox,
QDialog QTextEdit {
    background-color: rgb(40, 44, 52);
    color: rgb(221, 221, 221);
    border: 1px solid rgb(52, 59, 72);
    border-radius: 4px;
    padding: 6px 10px;
}

QDialog QLineEdit:focus,
QDialog QSpinBox:focus,
QDialog QTextEdit:focus {
    border: 1px solid rgb(189, 147, 249);
}

/* Scroll area */
QScrollArea {
    border: none;
    background-color: transparent;
}

/* Scrollbar */
QScrollBar:vertical {
    background-color: rgb(33, 37, 43);
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: rgb(52, 59, 72);
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgb(189, 147, 249);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    height: 0;
}
