# Home Assistant connection
HA_URL=http://homeassistant.local:8123
HA_ACCESS_TOKEN=your_long_lived_token_here
HA_VERIFY_SSL=true
HA_REQUEST_TIMEOUT=10

# WiFi polling interval (seconds, >= 1.0 for ≥1Hz)
WIFI_POLL_INTERVAL=1.0

# Target MAC addresses (comma-separated, optional - empty = discover all)
WIFI_TARGET_MACS=

# Device offline timeout (seconds after last RSSI reading)
WIFI_DEVICE_OFFLINE_TIMEOUT=60.0

# MQTT broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=wifi
MQTT_CLIENT_ID=smart-room-wifi-collector
MQTT_QOS=1
MQTT_RETAIN=false

# Router direct RSSI polling (optional)
# Supported types: openwrt, unifi, asuswrt, ssh_generic
WIFI_ROUTER_TYPE=
WIFI_ROUTER_HOST=192.168.1.1
WIFI_ROUTER_USERNAME=admin
WIFI_ROUTER_PASSWORD=
